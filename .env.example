# Alpaca (paper)
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# AI providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Models — analyst tier (P1, P2, P3)
CLAUDE_ANALYST_MODEL=claude-sonnet-4-6
OPENAI_ANALYST_MODEL=gpt-4o
GEMINI_ANALYST_MODEL=gemini-1.5-pro

# Models — committee tier (P4)
CLAUDE_COMMITTEE_MODEL=claude-opus-4-7
OPENAI_COMMITTEE_MODEL=gpt-4o
GEMINI_COMMITTEE_MODEL=gemini-1.5-pro

# DB
DATABASE_URL=sqlite:///data/trader.db

# Mode
TRADING_MODE=paper
LOG_LEVEL=INFO
